# Choose a provider:
# ollama = local development
# gemini = Streamlit Cloud or local Gemini testing
LLM_PROVIDER=ollama

# Ollama settings (used only when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Gemini settings (used only when LLM_PROVIDER=gemini)
# Keep this value empty. Add the actual key in Streamlit Cloud Secrets.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Retrieval settings
TOP_K=3
CHUNK_SIZE=1200
CHUNK_OVERLAP=100
